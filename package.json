{
  "name": "lumen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && vitest run --config vitest.realtime.config.ts",
    "test:fast": "vitest run",
    "test:realtime": "vitest run --config vitest.realtime.config.ts",
    "test:coverage": "vitest run --project core --coverage.enabled --coverage.include=packages/core/resilience/** --coverage.thresholds.lines=90 --coverage.thresholds.branches=90",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "fake-portal": "pnpm --filter @lumen/fake-portal start",
    "fake-portal:dev": "pnpm --filter @lumen/fake-portal dev",
    "server": "pnpm --filter @lumen/server start",
    "server:dev": "pnpm --filter @lumen/server dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
