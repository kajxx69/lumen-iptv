{
  "name": "@lumen/fake-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Portail Stalker factice avec API d'injection de pannes, pour les tests.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:dist": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "assets": "tsx src/media/generate-assets-cli.ts"
  },
  "dependencies": {
    "fastify": "^5.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
